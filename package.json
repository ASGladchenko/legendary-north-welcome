{
  "name": "legendary-north-welcome",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate:assets && npm run generate:bg-previews && next build",
    "generate:assets": "npm run generate:oracle-assets && npm run generate:pumpkin-assets && npm run generate:spider-assets && npm run generate:halloween-canada-assets",
    "generate:bg-previews": "node scripts/generate-bg-previews.mjs",
    "generate:oracle-assets": "assetpack --config assetpack.config.mjs",
    "generate:pumpkin-assets": "assetpack --config assetpack.pumpkin-cube.config.mjs",
    "generate:spider-assets": "node scripts/generate-spider-spritesheet.mjs",
    "generate:halloween-canada-assets": "node scripts/generate-halloween-canada-assets.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "dayjs": "^1.11.23",
    "gsap": "^3.15.0",
    "next": "16.3.6",
    "pixi.js": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@assetpack/core": "^1.7.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
